APP_NAME=php-sample # Example, based on .env.example
APP_ENV=local # Example, based on .env.example
APP_PORT=8080 # Add this line or ensure it's present

PHP_VERSION=8.2

APP_ROOT=
PHP_EXT_SET=lite

# DB
DB_CONNECTION=mysql # Example, based on .env.example
DB_HOST=db # Example, based on .env.example
DB_PORT=3306 # Example, based on .env.example
DB_DATABASE=php_app # Example, based on .env.example
DB_USERNAME=admin # Example, based on .env.example
DB_PASSWORD=secret # Example, based on .env.example
DB_ROOT_PASSWORD=root_secret # Example, based on .env.example